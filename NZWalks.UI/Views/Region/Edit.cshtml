@model NZWalks.UI.Models.DTOs.RegionDto
@{
    ViewData["Title"] = "Edit Page";
}
<h1 class="mt-3">Edit Region</h1>
@if (Model is not null)
{
    <body>
        <form method="post" asp-action="Edit">

            <div class="mt-3">
                <label class="form-lable">Id</label>
                <input type="text" class="form-control" asp-for="Id" readonly />
            </div>

            <div class="mt-3">
                <label class="form-lable">Code</label>
                <input type="text" class="form-control" asp-for="Code" />
            </div>

            <div class="mt-3">
                <label class="form-lable">Name</label>
                <input type="text" class="form-control" asp-for="Name" />
            </div>

            <div class="mt-3">
                <label class="form-lable">Image URL</label>
                <input type="text" class="form-control" asp-for="RegionImageUrl" />
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Save Region</button>
            </div>

        </form>
    </body>
}


