@model List<NZWalks.UI.Models.DTOs.RegionDto>
@{
    ViewData["Title"] = "All Region Page";
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NZWalks</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NZWalks.UI.styles.css" asp-append-version="true" />
</head>
<body>
    <h2 class="mt-4">Region data</h2>
    <div class="d-flex justify-content-end">
        <a class="btn btn-secondary" asp-controller="Region" asp-action="Add">Add Region</a>
    </div>
    <table class="table" border="2px">
        <thead>
            <tr>
                <th>Id</th>
                <th>Code</th>
                <th>Name</th>
                <th>Image Url</th>
                <th> </th>
                <th> </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Code</td>
                    <td>@item.Name</td>
                    <td>@item.RegionImageUrl</td>
                    <td><a class="btn btn-light" asp-controller="Region" asp-action="Edit" asp-route-id="@item.Id">Edit</a></td>
                    @*  <td><a class="btn btn-danger" asp-controller="Region" asp-action="Delete" asp-route-id="@item.Id">Delete</a></td>  
                this will directly delete the region without confirmation and this will take the [HttpGet] action verb controller *@
                    <td>
                        <form asp-controller="Region" asp-action="Delete" method="post"
                              onsubmit="return confirm('Are you sure you want to delete this region?');">

                            <input type="hidden" name="id" value="@item.Id" />

                            <button type="submit" class="btn btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</body>
